<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal -->

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/gray_100</item>
        <item name="android:textColor">@color/gray_900</item>
    </style>

    <!-- Tema sem ActionBar -->

    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/gray_100</item>
        <item name="android:textColor">@color/gray_900</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- Tema para diálogos centralizados -->
    <style name="DialogCenter" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- TextInputLayout para campos editáveis (estilo Flutter) -->
    <style name="EditavelInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/tint_editavel_stroke</item>
        <item name="hintTextColor">@color/tint_editavel_hint</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextAppearance">@style/EditavelHint</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <style name="EditavelHint" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Campos do editor de itens do Eletro da semana (cantos 12, foco vermelho) -->
    <style name="EletroInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/tint_editavel_stroke</item>
        <item name="hintTextColor">@color/tint_editavel_hint</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextAppearance">@style/EditavelHint</item>
        <item name="android:textColorHint">#757575</item>
    </style>

</resources>