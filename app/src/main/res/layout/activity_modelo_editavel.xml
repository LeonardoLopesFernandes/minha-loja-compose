<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTituloModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODELO EDITÁVEL"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:paddingBottom="12dp" />

            <!-- PREVIEW -->
            <LinearLayout
                android:id="@+id/cvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_edit_bg"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PRÉ-VISUALIZAÇÃO"
                    android:textSize="13sp"
                    android:textColor="#C62828"
                    android:textStyle="bold"
                    android:gravity="center" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:id="@+id/layoutPageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_page_indicator"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPageIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPreviewStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#757575"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/cbOverlay"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:button="@null"
                        android:background="@drawable/selector_checkbox_overlay"
                        android:checked="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <TextView
                        android:id="@+id/tvOverlayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Overlay"
                        android:textColor="#1D1B20"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cópias:"
                        android:textSize="12sp"
                        android:textColor="#1D1B20"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/etCopiaQuantidade"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:background="@drawable/input_edit_bg"
                        android:paddingHorizontal="6dp"
                        android:textSize="12sp"
                        android:inputType="number"
                        android:gravity="center"
                        android:text="1" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGerarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="GERAR PRÉ-VISUALIZAÇÃO"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_model_red" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEditarItens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="EDITAR ITENS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/layoutMultiForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />


        </LinearLayout>
    </ScrollView>

    <!-- Barra fixa de ações -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="10dp"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutBotoesRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="VOLTAR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:background="@drawable/btn_model_outline"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCompartilhar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="IMPRIMIR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_model_red"
                android:enabled="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSharePdf"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="COMPARTILHAR PDF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_dark_red_rounded"
            android:visibility="gone"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
