<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER BRANCO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:fitsSystemWindows="true"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btnMenuHamburguer"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="☰"
                android:textSize="20sp"
                android:textColor="#D81B3A"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/layoutHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgHeaderMenuIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:src="@drawable/logo_menu"
                        android:tint="#D81B3A"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#D81B3A" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/imgLogoHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:src="@drawable/icon_header"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_gravity="center" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnProfile"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_profile"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgProfileIconDefault"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_avatar"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/imgProfilePhoto"
                    android:layout_width="43dp"
                    android:layout_height="43dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Fragment Container (sem cards - o fragmento tem seu próprio layout) -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Menu overlay -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/menuBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/containerMenuRetangular"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/menu_bg_rounded"
            android:elevation="12dp"
            android:layout_marginTop="62dp"
            android:layout_marginStart="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="start">

                <ImageView
                    android:id="@+id/imgLogoMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/logo_menu"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="minha loja"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnEtiquetas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:id="@+id/imgIconEtiquetas"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/eti_avulsa"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETIQUETA AVULSA"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#FFFFFF"
                    android:alpha="0.15" />

                <LinearLayout
                    android:id="@+id/btnPapeletas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:id="@+id/imgIconPapeletas"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/pap_avulsa"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAPELETA AVULSA"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#FFFFFF"
                    android:alpha="0.15" />

                <LinearLayout
                    android:id="@+id/btnEtiquetaAvulsa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:id="@+id/imgIconEtiquetaAvulsa"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/eti_diaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETIQUETAS DIÁRIAS"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#FFFFFF"
                    android:alpha="0.15" />

                <LinearLayout
                    android:id="@+id/btnPapeletaDiaria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:id="@+id/imgIconPapeletaDiaria"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/pap_diaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAPELETAS DIÁRIAS"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
