<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D81B3A">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layoutCarregamentoCustom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D81B3A" 
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <io.loja.ui.LogoAnimadoView
            android:id="@+id/imgLogoPreenchimento"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tvMarcaLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="minha loja"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:alpha="0"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tvStatusCarregamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Carregando credenciais..."
            android:textColor="#FFFFFF" 
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

</FrameLayout>
