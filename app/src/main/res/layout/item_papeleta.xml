<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Linha 1: Quantidade | Descrição + tvPrice | IMPRIMIR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etQuantidade"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="1"
                android:gravity="center"
                android:inputType="number"
                android:background="@drawable/et_quantity_border"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:padding="0dp"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Produto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnImprimir"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/printer"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:padding="2dp"
                android:tint="#4CAF50"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Linha 2: DEP/EAN/SAP | REMOVER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvEan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EAN: 0000000000000/SAP: 000000"
                    android:textSize="10sp"
                    android:textColor="#757575"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:id="@+id/layoutLeveGanhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/badge_green_container"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvLeveGanhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginHorizontal="4dp" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvBadgeTipoLeve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:text="leve e ganhe"
                        android:background="#FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutDepor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tvValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50" />

                    <TextView
                        android:id="@+id/tvBadgeTipoDepor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#9E9E9E"
                        android:background="#FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />

                </LinearLayout>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRemover"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/remove"
                android:tint="#D81B3A"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:padding="2dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
