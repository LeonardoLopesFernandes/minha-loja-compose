<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#DA1C2E">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Perfil"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.015" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="12dp" />

            <!-- Avatar -->
            <FrameLayout
                android:id="@+id/btnAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_profile_avatar"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgProfilePhoto"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgProfileIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="#DA1C2E" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="28dp" />

            <!-- Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_profile_card"
                android:elevation="8dp"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="28dp">

                <!-- Name -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usuário"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#DA1C2E"
                    android:lineSpacingExtra="5.6dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toque no nome para definir um apelido"
                    android:textSize="11sp"
                    android:textColor="#9AA5B1"
                    android:gravity="center" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="20dp" />

                <!-- Email row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_email"
                        android:tint="#DA1C2E" />

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@exemplo.com"
                        android:textSize="15sp"
                        android:textColor="#5F6368" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="20dp" />

                <!-- Store row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:tint="#DA1C2E" />

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/tvProfileStore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loja L291"
                        android:textSize="15sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="16dp" />

                <!-- IP Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP DA IMPRESSORA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#DA1C2E"
                    android:letterSpacing="0.1" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="6dp" />

                <!-- IP Input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etPrinterIp"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_input"
                        android:paddingHorizontal="14dp"
                        android:textSize="15sp"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#9CA3AF"
                        android:hint="Ex: 10.25.168.24"
                        android:inputType="text"
                        android:singleLine="true" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/btnSalvarIp"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="18dp"
                        android:gravity="center"
                        android:text="SALVAR"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_profile_save_btn"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="6dp" />

                <!-- Helper text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usado na impressão via socket (papeletas)"
                    android:textSize="12sp"
                    android:textColor="#5F6368" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="16dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E9EAEE" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="32dp" />

            <!-- Logout button -->
            <FrameLayout
                android:id="@+id/btnSairConta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_profile_logout"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_lock_power_off"
                        android:tint="#FFFFFF" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sair da conta"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
