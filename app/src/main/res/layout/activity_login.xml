<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D32F2F"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- (Opcional) Texto de fundo gigante "a" mantido, mas ajustado para não cortar -->
    <TextView
        android:id="@+id/txtFundoGigante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="a"
        android:textColor="#99111111"
        android:textSize="310sp"
        android:alpha="0.15"
        android:includeFontPadding="false"
        android:scaleX="6.0"
        android:scaleY="6.0"
        android:translationX="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55" />

    <!-- 1. Área do Logo e Título -->
    <LinearLayout
        android:id="@+id/headerLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/containerLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45">

        <io.loja.ui.LogoAnimadoView
            android:id="@+id/logoGrande"
            android:layout_width="84dp"
            android:layout_height="84dp" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="minha loja"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:alpha="0.0" />

        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Para ter acesso ao portal, vamos manter os fluxos de autenticação segura."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:alpha="0.0" />
    </LinearLayout>

    <!-- 2. Card de Login Branco -->
    <LinearLayout
        android:id="@+id/containerLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/headerLogin"
        app:layout_constraintBottom_toTopOf="@id/tvVersaoLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Card Branco -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="americanas.io"
                android:textColor="#1F1F1F"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal" />

            <!-- Botão ENTRAR -->
            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Login Microsoft"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_microsoft"
                app:iconGravity="textStart"
                app:iconTint="@null"
                app:iconPadding="8dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/tvVersaoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="versão 1.1.70"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:alpha="0.85"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
